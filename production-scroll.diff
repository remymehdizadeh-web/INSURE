# Apply this to github.com/SimpleCOMPANIES/SimpleINSURE.
# Do not open a pull request there.
#
# Measured on https://www.simpleinsure.co/ (20 Oct 2026), Chromium 141, 1440x900:
#   html class includes "lenis lenis-smooth"
#   window has a non-passive wheel listener and a non-passive touchmove listener
#   mouse.wheel deltaY 800 moves window.scrollY to 12 immediately and 96 after 700ms
#   .h-pin is 3704px tall and .h-sticky is position:sticky, so that distance
#   is a pinned horizontal slide of the practices rail
#
# The published files below are the ones to edit. Paths match the live site root.

diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -213,7 +213,4 @@
   </div>
 </footer>
-<script src="vendor/gsap.min.js" defer></script>
-<script src="vendor/ScrollTrigger.min.js" defer></script>
-<script src="vendor/lenis.min.js" defer></script>
-<script src="site.js?v=5" defer></script>
+<script src="site.js?v=6" defer></script>
 </body>
 </html>

# Remove the same three vendor script tags from every other page template.
# Delete vendor/gsap.min.js, vendor/ScrollTrigger.min.js, and vendor/lenis.min.js.
# They are what register the non-passive wheel and touchmove listeners.

diff --git a/site.css b/site.css
--- a/site.css
+++ b/site.css
@@ -27,1 +27,1 @@
-html{scroll-behavior:smooth}
+html{scroll-behavior:auto}
@@ -496,3 +496,3 @@
-.hero-media{position:absolute;inset:0;overflow:hidden}
-.ken{position:absolute;inset:-8%}
+.hero-media{position:absolute;inset:0;overflow:clip}
+.ken{position:absolute;inset:0}
@@ -515,7 +515,7 @@
-.h-pin{position:relative;height:280vh;background:#fff}
-.h-sticky{position:sticky;top:0;height:100vh;display:flex;overflow:hidden;background:#fff}
-.h-intro{width:min(500px,40vw);flex:none;display:flex;flex-direction:row;align-items:flex-end;padding:0 36px 64px 32px;position:relative;z-index:2;background:#fff}
+.h-pin{position:relative;height:auto;background:#fff;padding:112px 0 120px;overflow:visible}
+.h-sticky{position:static;top:auto;width:min(1120px,calc(100% - 48px));margin:0 auto;height:auto;display:block;overflow:visible;background:#fff}
+.h-intro{width:auto;flex:none;display:block;padding:0 0 40px;position:relative;z-index:2;background:transparent}
 .h-intro h2{font-size:clamp(68px,5.4vw,80px);line-height:1.02;color:var(--navy);letter-spacing:-.03em}
 .h-intro p{margin:32px 0 0;color:var(--muted);max-width:16em}
-.h-track{display:flex;height:100%;flex:none}
-.slide{position:relative;flex:0 0 52vw;min-width:0;height:100%;overflow:hidden;color:#fff;text-decoration:none;display:block}
+.h-track{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;height:auto;transform:none}
+.slide{position:relative;flex:none;width:auto;min-width:0;height:min(64vh,600px);min-height:420px;overflow:clip;color:#fff;text-decoration:none;display:block}

# overflow:clip clips the photograph the same way overflow:hidden did, but it
# does not create a scroll container. The old .ken { inset:-8% } made
# .hero-media about 130px taller than the viewport, so a wheel over the hero
# could be swallowed by that box. Keep any existing max-width:980px rules that
# already set .h-sticky { position:static }.

